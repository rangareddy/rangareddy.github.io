---
layout: null
permalink: /search.json
sitemap: false
---
[
  {%- for post in site.posts -%}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "dateLabel": {{ post.date | date: "%b %-d, %Y" | jsonify }},
    "kind": {{ post.kind | default: "post" | jsonify }},
    "categories": {{ post.categories | join: " " | jsonify }},
    "tags": {{ post.tags | join: " " | jsonify }},
    "summary": {% capture s %}{% include post-summary.html post=post %}{% endcapture %}{{ s | strip | jsonify }},
    {%- comment -%}
      strip_html keeps the text inside <script>/<style>, so indexing the body of
      a tool post would index its widget source. Index prose posts only.
    {%- endcomment -%}
    "body": {% if post.kind == "tool" %}""{% else %}{{ post.content | strip_html | normalize_whitespace | truncate: 2000 | jsonify }}{% endif %}
  }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
